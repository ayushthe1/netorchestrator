# NetOrchestrator - Environment Variables
# Copy this file to .env and update with your actual values

# ==========================================
# Database Configuration
# ==========================================
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5433
DATABASE_USER=netorch_admin
DATABASE_PASSWORD=SecurePass2025
DATABASE_DBNAME=netorch_mvp
DATABASE_SSLMODE=disable

# PostgreSQL Service (for docker-compose)
POSTGRES_DB=netorch_mvp
POSTGRES_USER=netorch_admin
POSTGRES_PASSWORD=${DATABASE_PASSWORD}

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==========================================
# NATS Message Bus Configuration
# ==========================================
NATS_URL=nats://nats:4222

# ==========================================
# InfluxDB Configuration
# ==========================================
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=netorchestrator-super-secret-token
INFLUXDB_ORG=netorchestrator
INFLUXDB_BUCKET=metrics
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=netorchestrator123

# InfluxDB Docker Init (used by docker-compose)
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=${INFLUXDB_TOKEN}

# ==========================================
# JWT & Security Configuration
# ==========================================
JWT_SECRET=netorchestrator-super-secret-key-change-in-production-2025
JWT_EXPIRATION=3600
SECURITY_JWT_SECRET=${JWT_SECRET}
SECURITY_RATE_LIMIT_RPS=100
SECURITY_RATE_LIMIT_BURST=10
SECURITY_ENABLE_AUDIT_LOGGING=true
SECURITY_ENCRYPTION_KEY=netorchestrator-encryption-key-32-byte
SECURITY_ENABLE_CORS=true
SECURITY_ALLOWED_ORIGINS=*
SECURITY_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
SECURITY_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-API-Key

# ==========================================
# Server Configuration
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=120

# ==========================================
# Grafana Configuration
# ==========================================
GRAFANA_ADMIN_PASSWORD=netorchestrator123
GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}

# ==========================================
# Logging Configuration
# ==========================================
LOGGING_LEVEL=info
LOGGING_FORMAT=json

# ==========================================
# Microservices Configuration (for future use)
# ==========================================
SERVICES_NETWORK_SERVICE_HOST=localhost
SERVICES_NETWORK_SERVICE_PORT=8081
SERVICES_MONITORING_SERVICE_HOST=localhost
SERVICES_MONITORING_SERVICE_PORT=8082
SERVICES_ORCHESTRATION_SERVICE_HOST=localhost
SERVICES_ORCHESTRATION_SERVICE_PORT=8083
SERVICES_VALIDATION_SERVICE_HOST=localhost
SERVICES_VALIDATION_SERVICE_PORT=8084

# ==========================================
# Prometheus Configuration
# ==========================================
# Prometheus doesn't require authentication by default
# If you need auth, add:
# PROMETHEUS_USERNAME=
# PROMETHEUS_PASSWORD=

# ==========================================
# Kafka Configuration (optional, for future use)
# ==========================================
# KAFKA_BROKERS=localhost:9092
# KAFKA_GROUP_ID=netorchestrator
