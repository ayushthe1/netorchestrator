{
  "dashboard": {
    "id": null,
    "title": "NetOrchestrator - Business Metrics",
    "tags": ["netorchestrator", "business", "kpi"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Resource Utilization",
        "type": "gauge",
        "targets": [
          {
            "expr": "netorchestrator_resource_utilization_percent",
            "legendFormat": "{{resource_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Cost Optimization",
        "type": "stat",
        "targets": [
          {
            "expr": "netorchestrator_cost_optimization_savings_total",
            "legendFormat": "Total Savings",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {"mode": "value", "fixedColor": "green"}
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Service Availability",
        "type": "stat", 
        "targets": [
          {
            "expr": "avg_over_time(netorchestrator_sla_compliance_percent[24h])",
            "legendFormat": "24h Average",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 99},
                {"color": "green", "value": 99.9}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 4,
        "title": "Customer Satisfaction Score",
        "type": "gauge",
        "targets": [
          {
            "expr": "netorchestrator_customer_satisfaction_score",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 10,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 6},
                {"color": "green", "value": 8}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 4}
      },
      {
        "id": 5,
        "title": "Network Growth Trend",
        "type": "graph",
        "targets": [
          {
            "expr": "increase(netorchestrator_networks_total[1d])",
            "legendFormat": "Daily Network Growth",
            "refId": "A"
          },
          {
            "expr": "increase(netorchestrator_nodes_total[1d])",
            "legendFormat": "Daily Node Growth", 
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "Count", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "Revenue Impact",
        "type": "graph",
        "targets": [
          {
            "expr": "increase(netorchestrator_revenue_impact_total[1h])",
            "legendFormat": "Hourly Revenue",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "USD", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 4}
      },
      {
        "id": 7,
        "title": "Automation Efficiency",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(netorchestrator_automation_tasks_completed_total[1h])",
            "legendFormat": "Tasks/Hour",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "decimals": 1,
            "color": {"mode": "value", "fixedColor": "blue"}
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 12}
      },
      {
        "id": 8,
        "title": "Error Budget Burn Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(netorchestrator_error_budget_consumed[1h])",
            "legendFormat": "Hourly Burn Rate",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Percentage/Hour", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 12}
      },
      {
        "id": 9,
        "title": "Top Business Metrics Summary",
        "type": "table",
        "targets": [
          {
            "expr": "netorchestrator_networks_total",
            "legendFormat": "Total Networks",
            "refId": "A"
          },
          {
            "expr": "netorchestrator_sla_compliance_percent",
            "legendFormat": "SLA Compliance %",
            "refId": "B"
          },
          {
            "expr": "netorchestrator_cost_optimization_savings_total",
            "legendFormat": "Cost Savings USD",
            "refId": "C"
          },
          {
            "expr": "rate(netorchestrator_automation_tasks_completed_total[24h])",
            "legendFormat": "Daily Automation Tasks",
            "refId": "D"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 10,
        "title": "Operational Excellence Score",
        "type": "gauge",
        "targets": [
          {
            "expr": "(netorchestrator_sla_compliance_percent * 0.4) + (netorchestrator_customer_satisfaction_score * 10 * 0.3) + (netorchestrator_resource_utilization_percent * 0.3)",
            "legendFormat": "Composite Score",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 70},
                {"color": "green", "value": 85}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m"
  }
}