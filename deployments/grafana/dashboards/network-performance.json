{
  "dashboard": {
    "id": null,
    "title": "NetOrchestrator - Network Performance",
    "tags": ["netorchestrator", "network", "performance"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Network Topology",
        "type": "stat",
        "targets": [
          {
            "expr": "netorchestrator_networks_active",
            "legendFormat": "Active Networks",
            "refId": "A"
          },
          {
            "expr": "netorchestrator_nodes_active",
            "legendFormat": "Active Nodes", 
            "refId": "B"
          },
          {
            "expr": "netorchestrator_links_active",
            "legendFormat": "Active Links",
            "refId": "C"
          }
        ],
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Network Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "netorchestrator_network_latency_seconds",
            "legendFormat": "{{network_id}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Latency (seconds)", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0}
      },
      {
        "id": 3,
        "title": "Network Throughput",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(netorchestrator_network_throughput_bytes_total[5m])",
            "legendFormat": "{{network_id}} - {{direction}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Bytes/sec", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
      },
      {
        "id": 4,
        "title": "Node Health Status",
        "type": "heatmap",
        "targets": [
          {
            "expr": "netorchestrator_node_cpu_usage_percent",
            "legendFormat": "{{node_id}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
      },
      {
        "id": 5,
        "title": "Policy Violations",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(netorchestrator_policy_violations_total[1h])",
            "legendFormat": "Last Hour",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 14}
      },
      {
        "id": 6,
        "title": "Network Provisioning Time",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(netorchestrator_network_provisioning_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(netorchestrator_network_provisioning_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "Seconds", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 18, "x": 6, "y": 14}
      },
      {
        "id": 7,
        "title": "SLA Compliance",
        "type": "gauge",
        "targets": [
          {
            "expr": "netorchestrator_sla_compliance_percent",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 95},
                {"color": "green", "value": 99}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 18}
      },
      {
        "id": 8,
        "title": "Network Events Timeline", 
        "type": "logs",
        "targets": [
          {
            "expr": "{job=\"netorchestrator\"} |= \"network\"",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 18, "x": 6, "y": 18}
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "refresh": "10s"
  }
}