{
    "swagger": "2.0",
    "info": {
        "description": "Enterprise Network-as-a-Service (NaaS) automation platform providing comprehensive network orchestration, monitoring, and management capabilities.",
        "title": "NetOrchestrator API",
        "contact": {
            "name": "NetOrchestrator Team",
            "url": "https://github.com/your-org/netorchestrator",
            "email": "support@netorchestrator.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "schemes": [
        "http",
        "https"
    ],
    "paths": {
        "/api/v1/health": {
            "get": {
                "description": "Check API health status and connectivity to all dependencies",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check endpoint",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "status": {
                                    "type": "string",
                                    "example": "healthy"
                                },
                                "timestamp": {
                                    "type": "string",
                                    "example": "2024-01-01T12:00:00Z"
                                },
                                "version": {
                                    "type": "string",
                                    "example": "1.0.0"
                                },
                                "dependencies": {
                                    "type": "object",
                                    "properties": {
                                        "database": {
                                            "type": "string",
                                            "example": "connected"
                                        },
                                        "redis": {
                                            "type": "string",
                                            "example": "connected"
                                        },
                                        "influxdb": {
                                            "type": "string",
                                            "example": "connected"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "status": {
                                    "type": "string",
                                    "example": "unhealthy"
                                },
                                "error": {
                                    "type": "string",
                                    "example": "Database connection failed"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/networks": {
            "get": {
                "description": "Retrieve all networks with optional filtering and pagination",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "networks"
                ],
                "summary": "List all networks",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Page number for pagination",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer", 
                        "description": "Number of items per page",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by network status",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "networks": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/Network"
                                    }
                                },
                                "total": {
                                    "type": "integer",
                                    "example": 100
                                },
                                "page": {
                                    "type": "integer", 
                                    "example": 1
                                },
                                "limit": {
                                    "type": "integer",
                                    "example": 20
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Create a new network with specified configuration",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "networks"
                ],
                "summary": "Create a new network",
                "parameters": [
                    {
                        "description": "Network configuration", 
                        "name": "network",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CreateNetworkRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/Network"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/networks/{id}": {
            "get": {
                "description": "Get detailed information about a specific network",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "networks"
                ],
                "summary": "Get network by ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Network ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Network"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "Update an existing network configuration",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "networks"
                ],
                "summary": "Update network",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Network ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Updated network configuration",
                        "name": "network",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/UpdateNetworkRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Network"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Delete a network and all associated resources",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "networks"
                ],
                "summary": "Delete network",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Network ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/nodes": {
            "get": {
                "description": "Retrieve all network nodes with filtering options",
                "tags": [
                    "nodes"
                ],
                "summary": "List all nodes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "nodes": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/Node"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/policies": {
            "get": {
                "description": "Retrieve all network policies",
                "tags": [
                    "policies"
                ],
                "summary": "List all policies",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "policies": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/Policy"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/metrics": {
            "get": {
                "description": "Retrieve network metrics and performance data",
                "tags": [
                    "metrics"
                ],
                "summary": "Get metrics",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Start time for metrics query",
                        "name": "start_time",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End time for metrics query",
                        "name": "end_time",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "metrics": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/Metric"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "Network": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "Production Network"
                },
                "description": {
                    "type": "string",
                    "example": "Main production network infrastructure"
                },
                "type": {
                    "type": "string",
                    "example": "vpc"
                },
                "cidr": {
                    "type": "string",
                    "example": "10.0.0.0/16"
                },
                "status": {
                    "type": "string",
                    "example": "active"
                },
                "config": {
                    "type": "object",
                    "additionalProperties": true
                },
                "created_at": {
                    "type": "string",
                    "example": "2024-01-01T12:00:00Z"
                },
                "updated_at": {
                    "type": "string",
                    "example": "2024-01-01T12:00:00Z"
                }
            }
        },
        "Node": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "network_id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "ip_address": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "config": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "Policy": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "rules": {
                    "type": "object",
                    "additionalProperties": true
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "Metric": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "source_type": {
                    "type": "string"
                },
                "source_id": {
                    "type": "integer"
                },
                "metric_name": {
                    "type": "string"
                },
                "value": {
                    "type": "number"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "CreateNetworkRequest": {
            "type": "object",
            "required": [
                "name",
                "type"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "example": "Development Network"
                },
                "description": {
                    "type": "string",
                    "example": "Network for development environment"
                },
                "type": {
                    "type": "string",
                    "example": "vpc"
                },
                "cidr": {
                    "type": "string",
                    "example": "10.0.0.0/16"
                },
                "config": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "UpdateNetworkRequest": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "config": {
                    "type": "object",
                    "additionalProperties": true
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Error message"
                },
                "code": {
                    "type": "string",
                    "example": "ERROR_CODE"
                },
                "details": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        }
    }
}